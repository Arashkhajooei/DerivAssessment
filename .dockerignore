# Keep the build context small and avoid copying host-specific state into
# the image. Anything not listed in the Dockerfile's COPY lines is
# excluded anyway; this mainly stops large/irrelevant paths from being
# sent to the daemon in the first place.

.git/
.gitignore

# A host virtualenv would be both huge and wrong for the container's
# platform -- dependencies are installed fresh inside the image.
.venv/
venv/

__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Derived artifacts are regenerated by `RUN python run.py` during the
# build, so shipping the host's copies would only risk staleness.
# NOTE: llm_calls.jsonl is deliberately NOT excluded -- it is the judge
# cache, and copying it lets the container reproduce the real LLM
# verdicts offline.
retrieval.json
automated_scores.json
llm_review.json
failure_taxonomy.json
recommendation.md
review_report.md
run_manifest.json

# Local session state and editor noise
.remember/
.claude/
.DS_Store
.env

# Docs and tooling not needed at runtime
Makefile
docs/
